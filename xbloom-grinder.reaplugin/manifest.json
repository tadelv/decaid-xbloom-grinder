{
  "id": "xbloom-grinder.reaplugin",
  "author": "tadelv",
  "name": "xBloom Studio Grinder",
  "description": "BLE grinder driver for the xBloom Studio: grind size, RPM, start/stop.",
  "version": "1.0.3",
  "apiVersion": 1,
  "permissions": [
    "transport.ble",
    "log",
    "api",
    "pluginStorage",
    "emit"
  ],
  "drivers": [
    {
      "id": "xbloom",
      "type": "grinder",
      "capabilities": [
        "startStop",
        "grindSetting",
        "rpmControl"
      ],
      "controls": {
        "grindSetting": {
          "kind": "numeric",
          "min": 1,
          "max": 80,
          "step": 1
        },
        "rpmControl": {
          "kind": "numeric",
          "min": 60,
          "max": 120
        }
      },
      "surfaces": [
        {
          "id": "settings",
          "role": "settings",
          "endpoint": "device-settings",
          "label": "Defaults"
        }
      ],
      "ble": {
        "match": {
          "name": {
            "prefix": "XBLOOM"
          }
        }
      }
    }
  ],
  "settings": {},
  "api": [
    {
      "id": "device-settings",
      "type": "http",
      "data": {}
    },
    {
      "id": "skin",
      "type": "http",
      "data": {}
    },
    {
      "id": "ui",
      "type": "http",
      "data": {}
    },
    {
      "id": "rpm",
      "type": "http",
      "data": {}
    },
    {
      "id": "changed",
      "type": "websocket",
      "data": {}
    }
  ]
}
